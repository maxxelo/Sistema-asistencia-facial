# Copia este archivo como .env y cambia los valores antes de levantar el sistema.
# El archivo .env real nunca se sube al repositorio.

# Base de datos PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=colegio_db

# Las APIs se conectan al contenedor "postgres" por la red interna de Docker
DB_HOST=postgres
DB_PORT=5432

# Firma de las sesiones (JWT): usa una cadena larga y aleatoria
JWT_SECRET=cambia-esta-cadena-por-una-larga-y-aleatoria
JWT_EXPIRES_IN=8h
