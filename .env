POSTGRES_USER=admin
# Usuario de PostgreSQL

POSTGRES_PASSWORD=admin123
# Contraseña — cámbiala por algo más seguro después

POSTGRES_DB=colegio_db
# Nombre de la base de datos que se crea automáticamente

DB_HOST=postgres
# El host es "postgres" — ese es el nombre del contenedor
# Las APIs usan este nombre para conectarse a la BD

DB_PORT=5432
# Puerto estándar de PostgreSQL